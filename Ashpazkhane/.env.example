# نمونهٔ فایل تنظیمات. آن را به .env کپی کنید و مقدارها را پر کنید.

DJANGO_SECRET_KEY=یک-کلید-تصادفی-بلند-بگذارید
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
# DJANGO_DB_PATH=/var/lib/ashpazkhane/db.sqlite3

ZARINPAL_SANDBOX=0
ZARINPAL_MERCHANT_ID=مرچنت-آیدی-واقعی

ORDER_CUTOFF_HOUR=9
# اصلاح اختلاف ساعت سیستم به دقیقه؛ روی سرور واقعی 0 بگذارید.
CLOCK_OFFSET_MINUTES=0

# امنیت ورود
LOGIN_MAX_ATTEMPTS=6
LOGIN_LOCKOUT_SECONDS=600

# در محیط واقعی (DEBUG=0) به‌طور پیش‌فرض کوکی‌ها فقط روی HTTPS ارسال می‌شوند.
# اگر پشت پراکسی HTTPS هستید: DJANGO_TRUST_PROXY_SSL=1
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_HSTS_SECONDS=31536000
